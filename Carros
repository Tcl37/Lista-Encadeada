#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef struct No {
    char modelo[20];
    float valor;
    float ipva;
    struct No *prox;
} carro;


// Cria um novo carro
carro* criarobj(char modeloP[20], float valorP) {

    carro *novocar = (carro*) malloc(sizeof(carro));

    if (novocar == NULL) {
        printf("Erro de memoria !!!");
        exit(1);
    }

    strcpy(novocar->modelo, modeloP);
    novocar->valor = valorP;
    novocar->ipva = 0.0;
    novocar->prox = NULL;

    return novocar;
}


// Calcula o IPVA
void calcularIPVA(carro *novocar) {

    if (novocar->valor <= 40000.0) {
        novocar->ipva = 0.0;
    }
    else if (novocar->valor <= 70000.0) {
        novocar->ipva = novocar->valor * 2 / 100;
    }
    else {
        novocar->ipva = novocar->valor * 3 / 100;
    }
}


// Insere no início
void inseririnicio(carro **lista, char modeloP[20], float valorP) {

    carro *novocar = criarobj(modeloP, valorP);

    calcularIPVA(novocar);

    novocar->prox = *lista;
    *lista = novocar;
}


// Insere no fim
void inserirfim(carro **lista, char modeloP[20], float valorP) {

    carro *novocar = criarobj(modeloP, valorP);

    calcularIPVA(novocar);

    if (*lista == NULL) {
        *lista = novocar;
    }
    else {

        carro *temp = *lista;

        while (temp->prox != NULL) {
            temp = temp->prox;
        }

        temp->prox = novocar;
    }
}


// Imprime a lista
void imprimir(carro *lista) {

    while (lista != NULL) {

        printf("O modelo: %s", lista->modelo);
        printf("\nO valor: R$ %.2f", lista->valor);
        printf("\nO valor do IPVA: R$ %.2f", lista->ipva);
        printf("\n-----------------\n");

        lista = lista->prox;
    }
}


// Pesquisa um carro pelo modelo
carro* pesquisar(carro *lista, char modeloP[20]) {

    while (lista != NULL) {

        if (strcmp(lista->modelo, modeloP) == 0) {
            return lista;
        }

        lista = lista->prox;
    }

    return NULL;
}


// Altera os dados do carro
void alterar(carro *lista, char modeloAntigo[20],
             char modeloP[20], float valorP) {

    carro *obj = pesquisar(lista, modeloAntigo);

    if (obj != NULL) {

        strcpy(obj->modelo, modeloP);
        obj->valor = valorP;

        calcularIPVA(obj);

        printf("Objeto alterado!!\n");
    }
    else {
        printf("Objeto nao encontrado!!\n");
    }
}


int main() {

    carro *lista = NULL;

    inserirfim(&lista, "Gol", 40000.0);
    inserirfim(&lista, "Civic", 100000.0);
    inseririnicio(&lista, "Dolphin", 120000.0);

    printf("LISTA INICIAL\n");
    imprimir(lista);

    carro *busca = pesquisar(lista, "Civic");

    if (busca != NULL) {
        printf("\nObjeto encontrado: carro: %s\n", busca->modelo);
    }
    else {
        printf("\nObjeto nao encontrado\n");
    }

    alterar(lista, "Civic", "Opala", 90000.0);

    printf("\nLISTA APOS ALTERACAO\n");
    imprimir(lista);

    return 0;
}
