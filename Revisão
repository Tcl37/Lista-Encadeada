            case 5: {

                char nomeAntigo[80];
                char nomeNovo[80];
                float novoSalario;

                printf("\nDigite o nome do funcionario que deseja alterar: ");
                scanf(" %[^\n]", nomeAntigo);

                printf("Digite o novo nome: ");
                scanf(" %[^\n]", nomeNovo);

                printf("Digite o novo salario: ");
                scanf("%f", &novoSalario);

                alterar(lista, nomeAntigo, nomeNovo, novoSalario);

                break;
            }


            case 0:

                printf("\nPrograma encerrado!\n");

                break;


            default:

                printf("\nOpcao invalida!");

        }

    } while(i != 0);

    return 0;
}
    
    

    
